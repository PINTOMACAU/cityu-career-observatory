page {
  background: #f5f7fa;
  color: #1c1c1e;
  font-size: 30rpx;
  line-height: 1.55;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page {
  padding: 32rpx 28rpx 64rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #003366;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 30rpx;
  color: #003366;
  margin-bottom: 16rpx;
}

.body {
  font-size: 28rpx;
  color: #3a3a3c;
}

.muted {
  color: #8e8e93;
  font-size: 24rpx;
}

.divider {
  height: 1rpx;
  background: #e5e5ea;
  margin: 24rpx 0;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 24rpx;
}

.btn-primary {
  background: #003366;
  color: #fff;
}

.btn-primary[disabled] {
  background: #a9b6c6;
  color: #f0f2f5;
}

.btn-ghost {
  background: transparent;
  color: #003366;
  border: 2rpx solid #003366;
}

.row {
  display: flex;
  gap: 20rpx;
}

.row .btn {
  flex: 1;
}
