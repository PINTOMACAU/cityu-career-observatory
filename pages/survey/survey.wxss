.progress {
  height: 8rpx;
  background: #dfe3e8;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: #003366;
  transition: width 0.2s ease;
}

.progress-text {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #003366;
  margin-bottom: 20rpx;
}

.legend {
  margin-top: 8rpx;
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f2;
}

.field:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.label {
  font-size: 30rpx;
  color: #1c1c1e;
  margin-bottom: 14rpx;
}

.label-zh {
  font-size: 26rpx;
  color: #8e8e93;
  margin-top: 4rpx;
}

.req {
  color: #c1272d;
  margin-left: 6rpx;
}

.control {
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background: #f5f7fa;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1c1c1e;
}

.control.placeholder {
  color: #a1a6ad;
}

.textarea {
  min-height: 140rpx;
  line-height: 1.5;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  width: 100%;
}

.input {
  height: 80rpx;
}

.scale {
  display: flex;
  gap: 12rpx;
}

.scale-item {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #f5f7fa;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  color: #3a3a3c;
}

.scale-on {
  background: #003366;
  border-color: #003366;
  color: #fff;
}

.busy {
  opacity: 0.6;
}

.foot {
  text-align: center;
  margin-top: 24rpx;
}
